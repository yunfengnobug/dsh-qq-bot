{
  "name": "@fengye_nobug/dsh-qq-bot",
  "version": "0.2.8",
  "type": "module",
  "main": "index.js",
  "description": "把 DSH 会话接到 QQ（OneBot/NapCat）的插件。白名单默认全关；被 @、叫到昵称或被戳一定叫醒，其余消息按可调概率抽样。Fork 自 sj244/dsh-qq-bridge（MIT）。",
  "license": "MIT",
  "author": "yunfengnobug",
  "contributors": [
    "sj244 (upstream dsh-qq-bridge)"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "onebot",
    "napcat",
    "qq",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunfengnobug/dsh-qq-bot.git"
  },
  "homepage": "https://github.com/yunfengnobug/dsh-qq-bot#readme",
  "bugs": {
    "url": "https://github.com/yunfengnobug/dsh-qq-bot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./onebot.js": "./onebot.js",
    "./napcat.js": "./napcat.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "updates.js",
    "onebot.js",
    "napcat.js",
    "stickers.js",
    "faces.js",
    "client",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
